rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Story narration uploaded by the app (src/services/storageService.ts).
    // Readable by any signed-in reader (stories can be shared via Explore);
    // writable only by the owner, as audio, up to 10 MB.
    match /users/{userId}/stories/{storyId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
